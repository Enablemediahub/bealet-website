RewriteEngine On
RewriteBase /bealet-website/

<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(php|html?)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

Options -Indexes

# Redirect /bealet-website/something.php to /bealet-website/something
RewriteCond %{THE_REQUEST} \s/+bealet-website/([^\s?]+?)\.php(?:[\s?]|$) [NC]
RewriteRule ^ /bealet-website/%1 [R=301,L]

# Redirect /bealet-website/index.php to /bealet-website/
RewriteCond %{THE_REQUEST} \s/+bealet-website/index\.php(?:[\s?]|$) [NC]
RewriteRule ^ /bealet-website/ [R=301,L]

# Remove trailing slash from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /bealet-website/$1 [R=301,L]

# Serve extensionless URLs from matching PHP files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+?)(?:/)?$ $1.php [L]

# Handle nested routes such as /bealet-website/about/team
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/([^/]+?)$ $1/$2.php [L]
